modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]
run = "pnpm run dev"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-90c49cb4-9d5a-44cf-b047-dd57dbd6f6de"

[userenv]

[userenv.shared]
